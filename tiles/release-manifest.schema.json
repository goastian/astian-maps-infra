{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maps.astian.org/schemas/tile-release-manifest-v1.json",
  "title": "Astian Maps geodata release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "generatedAt",
    "osmDataTimestamp",
    "openMapTilesVersion",
    "artifacts",
    "rollbackReleaseIds"
  ],
  "properties": {
    "$schema": { "const": "./release-manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9.-]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "osmDataTimestamp": { "type": "string", "format": "date-time" },
    "openMapTilesVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tiles"],
      "properties": {
        "tiles": { "$ref": "#/$defs/artifact" },
        "valhallaGraph": { "$ref": "#/$defs/artifact" },
        "photonIndex": { "$ref": "#/$defs/artifact" }
      }
    },
    "rollbackReleaseIds": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "sizeBytes"],
      "properties": {
        "url": { "type": "string", "pattern": "^s3://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
