{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maps.astian.org/schemas/offline-package-v1.json",
  "title": "Astian Maps signed regional offline package",
  "description": "Canonical contract. Runtime validation and Ed25519 verification live in package-format.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "packageId", "region", "release", "artifacts", "totalSizeBytes", "signature"],
  "properties": {
    "$schema": { "const": "./offline-package.schema.json" },
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$" },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bounds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 2 },
        "bounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "dataTimestamp", "minimumAppVersion", "rollbackPackageIds"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "dataTimestamp": { "type": "string", "format": "date-time" },
        "minimumAppVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "rollbackPackageIds": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$" } }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "search", "routing"],
      "properties": {
        "map": { "$ref": "#/$defs/artifact" },
        "search": { "$ref": "#/$defs/artifact" },
        "routing": { "$ref": "#/$defs/artifact" }
      }
    },
    "totalSizeBytes": { "type": "integer", "minimum": 1 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{80,}={0,2}$" }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes", "mediaType", "format"],
      "properties": {
        "path": { "type": "string", "minLength": 3, "not": { "pattern": "(^/|:|(^|[/\\\\])\\.\\.([/\\\\]|$))" } },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "mediaType": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "format": { "enum": ["pmtiles-v3", "astian-search-v1", "astian-routing-v1"] }
      }
    }
  }
}
